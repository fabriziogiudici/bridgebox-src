# Controls the BridgeBox VM with vfkit (Apple Virtualization.framework).
#
#   BridgeBox start [--samba] [disk...]
#                       starts the VM in background, with the given partitions (e.g. disk10s2, as shown by 'diskutil
#                       list' or scripts/detect-partitions.sh) as additional disks, and waits until it's reachable over
#                       ssh; if partitions were given, opens the LUKS volumes and mounts the ZFS pools and btrfs
#                       filesystems found on them under /srv/bridgebox; with --samba, starts Samba (also if the VM
#                       is already running)
#   BridgeBox stop      unmounts the disks, closes the LUKS volumes and stops the VM (Stop, then HardStop if the guest
#                       doesn't react)
#   BridgeBox status    prints the VM state as reported by vfkit
#   BridgeBox ip        prints the IP address of the VM
#   BridgeBox disk-status [name]
#                       shows the status of the ZFS pools and of the btrfs filesystems in the VM, with all the details
#                       available (errors, TRIM, scrub, slow I/O operations, space); with a name, only of that pool,
#                       dataset (with its properties) or btrfs filesystem
#   BridgeBox trim {start [--wait] | stop} [name]
#                       starts (or resumes) the TRIM of the ZFS pools and trims the btrfs filesystems; with --wait,
#                       waits until it's finished; 'stop' suspends the TRIM of the ZFS pools; with a name, only of that
#                       pool or btrfs filesystem
#   BridgeBox scrub {start [--wait] | stop} [name]
#                       starts (or resumes) the scrub of the ZFS pools and of the btrfs filesystems; with --wait, waits
#                       until it's finished; 'stop' pauses it; with a name, only of that pool or btrfs filesystem
#   BridgeBox samba {start | stop | status}
#                       starts or stops Samba and its Bonjour announcement in the VM (it isn't started at boot), or
#                       shows whether it runs, with the connected clients and the open files
#   BridgeBox speed-test [--mixed]
#                       measures with fio the speed of each mounted pool and btrfs filesystem: sequential writes as a
#                       copy does them, then sequential reads; with '--mixed', reads and writes at the same time
#   BridgeBox ssh       opens an ssh session (or runs the given command) in the VM
#   BridgeBox uninstall removes BridgeBox, when installed by the package (with sudo)
#
# The VM must have been prepared with scripts/prepare-vm.sh ('make image').
#
set -euo pipefail

# shellcheck source=scripts/config.sh
source "$(cd "$(dirname "$0")/.." && pwd)/scripts/config.sh"

# Creates the socket directory, or makes sure that an existing one is a real directory owned by us and private.
prepare_socket_dir() {
    if [ ! -e "$SOCKET_DIR" ]; then
        mkdir -m 700 "$SOCKET_DIR"
    fi
    [ -d "$SOCKET_DIR" ] && [ ! -L "$SOCKET_DIR" ] || die "'$SOCKET_DIR' is not a directory"
    [ "$(stat -f %u "$SOCKET_DIR")" = "$(id -u)" ] || die "'$SOCKET_DIR' is not owned by the current user"
    chmod 700 "$SOCKET_DIR"
}

# Checks a partition to pass to the VM and makes it accessible to vfkit, which runs as the current user: macOS lets only
# root open a disk, so the device node is given to the user with sudo. The ownership lasts until the disk is disconnected, since
# macOS creates the device node again when the disk is connected.
# The block device (/dev/diskN) is used, not the raw one (/dev/rdiskN): vfkit reads the first 4 bytes of each disk to
# reject qcow2 images, and the raw device only accepts reads aligned to the sector size.
prepare_data_disk() {
    local disk="$1" dev plist mount
    echo "$disk" | grep -Eq '^disk[0-9]+(s[0-9]+)?$' \
        || die "'$disk' is not a disk identifier such as disk10s2 (see 'diskutil list')"
    dev="/dev/$disk"
    [ -e "$dev" ] || die "the partition $dev doesn't exist: is the disk connected? (see 'diskutil list')"

    plist="$(mktemp)"
    diskutil info -plist "$disk" > "$plist"
    mount="$(plutil -extract MountPoint raw -o - "$plist" 2>/dev/null || true)"
    rm -f "$plist"
    [ -z "$mount" ] || die "$disk is mounted by macOS on '$mount': unmount it first ('diskutil unmount $disk')"

    if [ ! -r "$dev" ] || [ ! -w "$dev" ]; then
        log "Giving $(id -un) access to $dev (sudo may ask for your password)"
        sudo chown "$(id -un)" "$dev"
    fi
}

vfkit_pid() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE")"
    ps -p "$pid" -o comm= 2>/dev/null | grep -q vfkit || return 1
    echo "$pid"
}

is_running() { vfkit_pid >/dev/null; }

rest() {
    local path="$1"
    shift
    curl -fsS --unix-socket "$SOCKET" "http://localhost$path" "$@"
}

# macOS writes MAC addresses in the leases file without leading zeros in each octet (e.g. 2:bb:b0:0:0:1).
lease_mac() {
    local IFS=: octet out=""
    for octet in $MAC; do
        out="$out:$(printf '%x' "0x$octet")"
    done
    echo "${out#:}"
}

# Prints the IP address of the VM, if found. Once the image has been sealed, the VM announces itself with Bonjour, which
# only answers while the VM is running; before (that is, during the provisioning by scripts/prepare-vm.sh) the DHCP
# lease of the VM is used, which can be left over from a previous run.
find_ip() {
    if [ -f "$SEALED" ]; then
        dscacheutil -q host -a name "$MDNS_NAME" | awk '/^ip_address:/ { print $2; exit }'
    else
        find_ip_in_leases
    fi
}

# Prints the IP of the most recent lease for our MAC address, if any.
# The hw_address field is either "1,<MAC>" (Ethernet) or, when the DHCP client of the guest sends a client identifier
# made of IAID and DUID as Alpine does, "ff,<client identifier>": that identifier ends with the MAC address.
find_ip_in_leases() {
    [ -r "$LEASES" ] || return 1
    local mac
    mac="$(lease_mac)"
    awk -v mac="$mac" '
        /^\{/           { ip = ""; hw = ""; lease = "" }
        /ip_address=/   { sub(/.*ip_address=/, ""); ip = $0 }
        /hw_address=/   { sub(/.*hw_address=/, ""); hw = $0 }
        /lease=/        { sub(/.*lease=/, ""); lease = $0 }
        /^\}/           {
            suffix = ":" mac
            if (ip != "" && (hw == "1," mac || substr(hw, length(hw) - length(suffix) + 1) == suffix)) print lease, ip
        }
    ' "$LEASES" | while read -r lease ip; do
        echo "$((lease)) $ip"
    done | sort -n | tail -1 | awk '{print $2}'
}

vm_ssh() {
    local ip
    ip="$(find_ip)" || true
    [ -n "$ip" ] || die "can't find the IP address of the VM: is it running?"
    ssh -i "$SSH_KEY" -o IdentitiesOnly=yes -o UserKnownHostsFile="$KNOWN_HOSTS" -o StrictHostKeyChecking=accept-new \
        -o ConnectTimeout=5 "$SSH_USER@$ip" "$@"
}

# Starts the sharing services given ('samba') in the VM.
start_sharing() {
    local service
    for service in "$@"; do
        vm_ssh -o LogLevel=ERROR doas "$BACKEND" "$service" start || warn "$service could not be started"
    done
}

cmd_start() {
    local arg disks=() sharing=()
    for arg in "$@"; do
        case "$arg" in
            --samba) sharing+=(samba) ;;
            -*)      die "usage: $(basename "$0") start [--samba] [disk...]" ;;
            *)       disks+=("$arg") ;;
        esac
    done

    need "$VFKIT" curl ssh diskutil plutil sudo dscacheutil
    check_paths
    [ -f "$DISK" ] || die "the VM has not been prepared: run 'make image' first"

    if is_running; then
        log "The VM is already running"
        [ ${#disks[@]} -eq 0 ] || warn "disks can't be added to a running VM: stop it first"
        start_sharing ${sharing[@]+"${sharing[@]}"}
        return
    fi

    local disk disk_args=()
    for disk in ${disks[@]+"${disks[@]}"}; do
        prepare_data_disk "$disk"
        disk_args+=(--device "virtio-blk,path=/dev/$disk,type=dev")
    done

    prepare_socket_dir

    # Once the image has been sealed, its disk is attached read-only and cloud-init isn't used anymore; the EFI
    # variables, which the firmware writes, are created from scratch at each start in the socket directory.
    local system_disk="virtio-blk,path=$DISK" efi_vars="$EFI_VARS" cloud_init_args=()
    if [ -f "$SEALED" ]; then
        system_disk="$system_disk,readonly"
        efi_vars="$SOCKET_DIR/efi-vars"
        rm -f "$efi_vars"
    else
        cloud_init_args=(--cloud-init "$CLOUD_INIT_DIR/user-data,$CLOUD_INIT_DIR/meta-data")
    fi

    log "Starting the VM"
    rm -f "$SOCKET"
    nohup "$VFKIT" \
        --cpus "$CPUS" \
        --memory "$MEMORY_MB" \
        --bootloader "efi,variable-store=$efi_vars,create" \
        --device "$system_disk" \
        ${disk_args[@]+"${disk_args[@]}"} \
        --device "virtio-net,nat,mac=$MAC" \
        --device virtio-rng \
        --device "virtio-serial,logFilePath=$CONSOLE_LOG" \
        ${cloud_init_args[@]+"${cloud_init_args[@]}"} \
        --restful-uri "unix://$SOCKET" \
        > "$VFKIT_LOG" 2>&1 < /dev/null &
    echo $! > "$PID_FILE"

    local deadline=$((SECONDS + BOOT_TIMEOUT)) ip=""

    log "Waiting for the VM to get an IP address (timeout ${BOOT_TIMEOUT}s)"
    until [ -n "$ip" ]; do
        is_running || die "vfkit exited unexpectedly, see $VFKIT_LOG"
        [ $SECONDS -lt $deadline ] || die "the VM didn't get an IP address, see $CONSOLE_LOG and $VFKIT_LOG"
        sleep 2
        ip="$(find_ip)" || true
    done

    log "Waiting for ssh on $ip"
    until vm_ssh -o BatchMode=yes true 2>/dev/null; do
        is_running || die "vfkit exited unexpectedly, see $VFKIT_LOG"
        [ $SECONDS -lt $deadline ] || die "the VM is not reachable over ssh, see $CONSOLE_LOG and $VFKIT_LOG"
        sleep 2
    done

    log "The VM is running at $ip ('BridgeBox ssh' to log in)"

    # The sharing services are started before the disks are mounted: the back-end adds the shares of the mounted
    # volumes to the running services, and reports them.
    start_sharing ${sharing[@]+"${sharing[@]}"}

    # The back-end in the VM opens the LUKS volumes found on the disks, then mounts the ZFS pools and the btrfs
    # filesystems found on the disks and in the LUKS volumes under /srv/bridgebox, asking for the passphrases of the
    # LUKS volumes and of the encrypted pools: ssh allocates a terminal (-t) for that.
    if [ ${#disks[@]} -gt 0 ]; then
        vm_ssh -t doas "$BACKEND" mount || warn "not all the filesystems on the disks could be mounted"
    fi
}

# Waits up to $1 seconds for vfkit to exit; returns 1 on timeout.
wait_for_exit() {
    local deadline=$((SECONDS + $1))
    while is_running; do
        [ $SECONDS -lt $deadline ] || return 1
        sleep 1
    done
}

cmd_stop() {
    local pid
    if ! pid="$(vfkit_pid)"; then
        log "The VM is not running"
        rm -f "$PID_FILE" "$SOCKET"
        return
    fi

    # Before powering off, the back-end unmounts the btrfs filesystems and exports the ZFS pools. If that fails, for
    # instance because a file on the disks is still open, the VM is left running; if the VM can't be reached (ssh exits
    # with 255), it's stopped anyway.
    if [ -f "$SEALED" ]; then
        local ip status=0
        ip="$(find_ip)" || true
        if [ -z "$ip" ]; then
            warn "can't find the VM to unmount the disks"
        else
            vm_ssh doas "$BACKEND" unmount || status=$?
            if [ "$status" -eq 255 ]; then
                warn "can't reach the VM to unmount the disks"
            elif [ "$status" -ne 0 ]; then
                die "the disks can't be unmounted (is a file on them still open?): the VM is still running"
            fi
        fi
    fi

    log "Stopping the VM (timeout ${STOP_TIMEOUT}s)"
    rest /vm/state -X POST -d '{"state": "Stop"}' >/dev/null || warn "the Stop request failed"

    if ! wait_for_exit "$STOP_TIMEOUT"; then
        warn "the guest didn't shut down, forcing it off (HardStop)"
        rest /vm/state -X POST -d '{"state": "HardStop"}' >/dev/null || warn "the HardStop request failed"
        if ! wait_for_exit 10; then
            warn "vfkit is still running, terminating it"
            kill "$pid" 2>/dev/null || true
            wait_for_exit 10 || kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    rm -f "$PID_FILE" "$SOCKET"
    log "The VM is stopped"
}

cmd_status() {
    if is_running; then
        rest /vm/state
        echo
    else
        echo "not running"
    fi
}

# Quotes the arguments for the shell of the VM, since ssh passes the command as a single string: otherwise a name with
# spaces (e.g. of a btrfs filesystem) would be split.
quoted() {
    local arg
    for arg in "$@"; do
        printf ' %q' "$arg"
    done
}

cmd_disk_status() {
    [ $# -le 1 ] && [[ "${1:-}" != -* ]] || die "usage: $(basename "$0") disk-status [name]"
    is_running || die "the VM is not running"
    vm_ssh -o LogLevel=ERROR "doas $BACKEND disk-status$(quoted "$@")"
}

# Checks the arguments of the commands that start or stop a background operation on the disks:
# {start [--wait] | stop} [name], where name is a pool or a btrfs filesystem.
check_start_stop() {
    local command="$1"
    shift
    local usage
    usage="usage: $(basename "$0") $command {start [--wait] | stop} [name]"
    case "${1:-}" in
        start) shift; [ "${1:-}" != --wait ] || shift ;;
        stop)  shift ;;
        *)     die "$usage" ;;
    esac
    [ $# -le 1 ] || die "$usage"
    case "${1:-}" in -*) die "$usage" ;; esac
}

# ssh allocates a terminal (-t) to the commands that can wait, so that Ctrl-C stops waiting.
cmd_trim() {
    check_start_stop trim "$@"
    is_running || die "the VM is not running"
    vm_ssh -t -o LogLevel=ERROR "doas $BACKEND trim$(quoted "$@")"
}

cmd_scrub() {
    check_start_stop scrub "$@"
    is_running || die "the VM is not running"
    vm_ssh -t -o LogLevel=ERROR "doas $BACKEND scrub$(quoted "$@")"
}

cmd_samba() {
    [ $# -eq 1 ] && [[ "$1" =~ ^(start|stop|status)$ ]] \
        || die "usage: $(basename "$0") samba {start | stop | status}"
    is_running || die "the VM is not running"
    vm_ssh -o LogLevel=ERROR doas "$BACKEND" samba "$1"
}

# The back-end runs fio on each mounted volume in turn. ssh allocates a terminal (-t), so that Ctrl-C stops fio too;
# LogLevel=ERROR drops the "Connection to ... closed" message that ssh prints at the end when it allocates a terminal.
cmd_speed_test() {
    [ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = --mixed ]; } || die "usage: $(basename "$0") speed-test [--mixed]"
    is_running || die "the VM is not running: start it with the disks to test ('BridgeBox start disk...')"
    vm_ssh -t -o LogLevel=ERROR doas "$BACKEND" speed-test "$@"
}

cmd_ip() {
    local ip
    ip="$(find_ip)" || true
    [ -n "$ip" ] || die "can't find the IP address of the VM: is it running?"
    echo "$ip"
}

# Removes what the package installed. Files written by the VM are only in the temporary directory, which is removed too.
cmd_uninstall() {
    [ "${INSTALLED:-no}" = "yes" ] || die "uninstall is available only when BridgeBox has been installed by the package"
    [ "$(id -u)" = "0" ] || die "run it with sudo: sudo BridgeBox uninstall"
    if pgrep -f "$VFKIT" > /dev/null; then
        die "the VM is running: stop it first with 'BridgeBox stop' (without sudo)"
    fi

    log "Removing BridgeBox"
    rm -rf "$VM_DIR" "$INSTALLED_COMMAND" "/tmp/bridgebox-${SUDO_UID:-$(id -u)}"
    pkgutil --forget "$PKG_IDENTIFIER" > /dev/null 2>&1 || true
    log "BridgeBox has been uninstalled"
}

case "${1:-}" in
    start)   shift; cmd_start "$@" ;;
    stop)    cmd_stop ;;
    status)  cmd_status ;;
    ip)      cmd_ip ;;
    disk-status) shift; cmd_disk_status "$@" ;;
    trim)    shift; cmd_trim "$@" ;;
    scrub)   shift; cmd_scrub "$@" ;;
    samba)   shift; cmd_samba "$@" ;;
    speed-test) shift; cmd_speed_test "$@" ;;
    ssh)     shift; vm_ssh "$@" ;;
    uninstall) cmd_uninstall ;;
    *)       echo "Usage: $(basename "$0") {start [--samba] [disk...] | stop | status | ip" \
                  "| disk-status [name]" \
                  "| trim {start [--wait] | stop} [name] | scrub {start [--wait] | stop} [name]" \
                  "| samba {start | stop | status} | speed-test [--mixed] | ssh [command...] | uninstall}" >&2
             exit 1 ;;
esac
